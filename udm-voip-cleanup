#!/bin/bash
set -u
. /data/udm-voip/udm-voip-common
load_config

for range in $VOIP_IMS_RANGES; do
    ip route del "$range" table main 2>/dev/null || true
done
ip route flush table "$VOIP_ROUTE_TABLE" 2>/dev/null || true

while iptables -w 10 -t nat -D POSTROUTING -j UDM_VOIP >/dev/null 2>&1; do :; done
iptables -w 10 -t nat -F UDM_VOIP 2>/dev/null || true
iptables -w 10 -t nat -X UDM_VOIP 2>/dev/null || true

ip addr flush dev "$VOIP_INTERFACE" scope global 2>/dev/null || true
ip link del "$VOIP_INTERFACE" 2>/dev/null || true
